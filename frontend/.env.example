# ── Aterkia frontend environment ─────────────────────────────
# Salin ke `.env` lalu isi nilai sebenarnya. JANGAN commit `.env` (berisi secret).

# Supabase (wajib untuk auth, profile, storage)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket untuk lampiran form kontak (opsional, default 'contact-attachments')
VITE_SUPABASE_CONTACT_BUCKET=contact-attachments

# Formspree contact form (Form ID atau URL penuh)
VITE_FORMSPREE_ID=your-form-id

# Cloudflare Turnstile — SITE KEY SAJA (publik). JANGAN isi secret di sini.
# Secret Key hanya untuk server (Supabase edge function), bukan frontend.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
