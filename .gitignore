# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/
dist/
dist-ssr/
*.local

# Legacy backend removed from this repo (frontend + Supabase only now)
backend/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — NEVER commit real secrets/keys.
# Keep only .env.example (placeholders) tracked.
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
!.env.*.example

# Secret / key files scattered anywhere in the tree
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
serviceAccount*.json
credentials*.json

# Supabase local config that may contain project ref / keys
supabase/.temp/
supabase/.env

# Temporary files & caches
.cache/
.parcel-cache/
.next/
out/
.vercel
.turbo
*.tmp

# OS files
Thumbs.db
Desktop.ini
